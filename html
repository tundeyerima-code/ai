            padding: 10px 24px;
            border-radius: 100px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 28px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        /* sections general */
        section {
            padding: 70px 0;
            border-bottom: 1px solid #f0e7db;
        }

        .section-title {
            font-size: 2.2rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 48px;
            letter-spacing: -0.3px;
            color: #3a2c1f;
        }

        .section-title i {
            color: #cb7b3c;
            margin-right: 12px;
        }

        /* video showcase grid */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .video-card {
            background: white;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 12px 28px rgba(0,0,0,0.05);
