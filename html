            line-height: 1.5;
            scroll-behavior: smooth;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 28px;
        }

        /* header */
        .hero {
            padding: 60px 0 40px;
            text-align: center;
            background: linear-gradient(135deg, #fff5e6 0%, #ffffff 100%);
            border-radius: 0 0 48px 48px;
        }

        .badge {
            background: #f1e2cf;
            color: #aa7b3e;
            font-weight: 600;
            font-size: 0.85rem;
            display: inline-block;
            padding: 6px 16px;
            border-radius: 40px;
            letter-spacing: 0.3px;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 3.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #cb7b3c, #a55d2a);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto;
            color: #5a4a38;
        }

        .price-chip {
            background: #2e5f3e;
            color: white;
