            box-shadow: 0 20px 30px rgba(0,0,0,0.08);
        }

        .video-placeholder {
            background: #1f1e1b;
            aspect-ratio: 16 / 9;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            position: relative;
        }

        .video-placeholder iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .video-info {
            padding: 20px;
        }

        .video-info h3 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        /* offers cards */
        .offers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 32px;
        }

        .offer-card {
            background: white;
            padding: 28px 20px;
            border-radius: 32px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0,0,0,0.03);
            border: 1px solid #f0e2d4;
            transition: all 0.2s;
        }

        .offer-icon {
            font-size: 2.8rem;
            background: #f9efe5;
            width: 80px;
            height: 80px;
            line-height: 80px;
            border-radius: 60px;
            margin: 0 auto 20px;
            color: #cb7b3c;
        }

        .offer-card h3 {
            font-size: 1.5rem;
            margin-bottom: 12px;
        }

        /* feedback section (testimonials) */
        .feedback-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .testimonial {
            background: white;
            border-radius: 28px;
            padding: 28px;
            box-shadow: 0 6px 14px rgba(0,0,0,0.03);
            border: 1px solid #f0e2d4;
        }

        .stars {
            color: #f9b43a;
            margin-bottom: 14px;
            letter-spacing: 2px;
        }

        .testimonial-text {
            font-size: 1rem;
            line-height: 1.5;
            margin-bottom: 20px;
            color: #3f3529;
            font-style: italic;
        }

        .student-name {
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .student-name i {
            color: #cb7b3c;
        }

        /* article spice */
        .insight-article {
            background: #fff7ef;
            border-radius: 48px;
            padding: 40px 35px;
            margin-top: 20px;
            text-align: center;
            border: 1px solid #ffe5cc;
        }

        .insight-article h3 {
            font-size: 1.7rem;
            margin-bottom: 16px;
        }

        .insight-article p {
            max-width: 800px;
            margin: 0 auto;
            font-size: 1.05rem;
        }

        /* form section */
        .form-section {
            background: #ffffff;
            border-radius: 48px;
            padding: 48px 40px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.05);
            border: 1px solid #f0e2d4;
        }

        .form-group {
            margin-bottom: 24px;
        }

        label {
            font-weight: 600;
            display: block;
            margin-bottom: 8px;
        }

        input, textarea {
            width: 100%;
            padding: 14px 18px;
            border-radius: 28px;
            border: 1.5px solid #e9dfd3;
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            transition: 0.2s;
            background: #fefcf9;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: #cb7b3c;
            box-shadow: 0 0 0 3px rgba(203,123,60,0.1);
        }

        .disclaimer {
            background: #fef2e6;
            padding: 14px 20px;
            border-radius: 40px;
            font-size: 0.9rem;
            margin: 20px 0;
            text-align: center;
            border-left: 5px solid #cb7b3c;
            font-weight: 500;
        }

        .btn-submit {
            background: #2e5f3e;
            color: white;
            border: none;
            padding: 14px 32px;
            font-size: 1.1rem;
            font-weight: 700;
            border-radius: 40px;
            cursor: pointer;
            transition: 0.2s;
            width: 100%;
            font-family: 'Inter', sans-serif;
            letter-spacing: 0.3px;
        }

        .btn-submit:hover {
            background: #1f4a2f;
            transform: scale(0.98);
        }

        /* thank you page simulation via redirect */
        .footer-note {
            text-align: center;
            padding: 28px 0;
            color: #7f6e5b;
            font-size: 0.85rem;
        }

        @media (max-width: 700px) {
            h1 { font-size: 2.3rem; }
            .container { padding: 0 20px; }
            .form-section { padding: 32px 20px; }
        }
    </style>
</head>
<body>

