<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>AI Cinematic Construction | YouTube Automation Mastery</title>
    <!-- Google Fonts: Friendly, modern, readable -->
