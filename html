<script>
    // Redirect handler: "thank you" page with new URL after submit.
    // Builds a query string to simulate "thank you" with user info (non-sensitive)
    // This demonstrates redirect to a new URL (thankyou.html or custom thank you page).
    // Since we need a separate thank you URL but keep as single file, I'll create a dynamic but proper new URL.
    // To meet requirement: after submit, redirect to a THANK YOU PAGE with new URL.
    // We'll redirect to a "thankyou.html" but because we are in a single code, we can use URL parameters and display a "virtual" thank you message? 
    // But requirement: "redirect to a thank you page with new url". So I'll implement redirect to the same origin + "/thankyou" appended? 
    // The cleanest: after preventDefault, window.location.href to an internal thank you page that exists? But we don't have multi file. However we can dynamically create a new HTML state? 
    // Easiest: redirect to a data URI or create a new page URL with '?thanks=1' and show thank you content? but requirement explicitly new url + thank you page.
    // To satisfy fully: we will redirect to a separate page we create using window.location. But can't guarantee external server. I will instead build an internal thank you section that replaces current body content with a beautiful thank you page and update the URL using history.pushState to "/thank-you" .
    // This gives the user a thank you page with new URL (thanks route) and prevents breaking user expectation.
    // That's elegant and meets spec: after clicking submit, they see thank you page and URL changes to something like /thank-you.
    // So I'll implement that.
    
    const form = document.getElementById('leadForm');
    
    function showThankYouPage(name) {
        // Build a fresh thank you page content
        const mainContent = document.querySelector('.container');
        const heroElem = document.querySelector('.hero');
        const footerElem = document.querySelector('.footer-note');
        // Hide all other sections and create thank you overlay / new page content
        const allSections = document.querySelectorAll('section, .insight-article, .hero, .footer-note');
        allSections.forEach(el => {
            if(el.style) el.style.display = 'none';
        });
        // remove existing container or we recreate inside body
        const body = document.body;
        // ensure we clear extra
        const existingThank = document.getElementById('dynamicThankYou');
        if(existingThank) existingThank.remove();
        
        const thankDiv = document.createElement('div');
        thankDiv.id = 'dynamicThankYou';
        thankDiv.style.minHeight = '100vh';
        thankDiv.style.display = 'flex';
        thankDiv.style.alignItems = 'center';
        thankDiv.style.justifyContent = 'center';
        thankDiv.style.flexDirection = 'column';
        thankDiv.style.padding = '2rem';
        thankDiv.style.background = '#fefcf5';
        thankDiv.style.fontFamily = "'Inter', sans-serif";
        thankDiv.innerHTML = `
            <div style="max-width: 600px; text-align: center; background: white; padding: 50px 30px; border-radius: 64px; box-shadow: 0 20px 35px rgba(0,0,0,0.05); border: 1px solid #f2e5d8;">
                <i class="fas fa-check-circle" style="font-size: 4rem; color: #2e5f3e; margin-bottom: 20px;"></i>
                <h1 style="font-size: 2rem;">🎉 Thank You, ${escapeHtml(name)}!</h1>
                <p style="font-size: 1.2rem; margin: 20px 0;">We've received your enrollment request. You'll receive payment & access instructions on WhatsApp within 5 minutes.</p>
                <div style="background: #fef2e6; padding: 20px; border-radius: 32px; margin: 28px 0;">
                    <i class="fas fa-naira-sign"></i> <strong>₦5,000 Naira only</strong> — Payment link will be sent to your Gmail & WhatsApp.<br>
                    <span style="font-size: 0.9rem;">Get ready to master AI cinematic construction & YouTube automation!</span>
                </div>
                <a href="#" onclick="window.location.reload(); return false;" style="background: #cb7b3c; color: white; padding: 12px 28px; border-radius: 40px; text-decoration: none; font-weight: 600;">← Back to Homepage</a>
                <p style="margin-top: 30px; font-size: 0.8rem;">You can close this page or click above to return.</p>
            </div>
        `;
        document.body.appendChild(thankDiv);
        // Change URL using history.pushState to simulate new thank you page URL
        const newUrl = window.location.origin + window.location.pathname + '?thankyou=true';
        window.history.pushState({ thankYou: true }, 'Thank You', newUrl);
        // Clean leftover container hiding.
        const containers = document.querySelectorAll('.container, .hero, .footer-note');
        containers.forEach(c => { if(c.style) c.style.display = 'none'; });
        if(heroElem) heroElem.style.display = 'none';
        if(footerElem) footerElem.style.display = 'none';
        // also hide form-section original if visible
        const formSec = document.querySelector('.form-section');
        if(formSec) formSec.style.display = 'none';
    }
    
    function escapeHtml(str) {
        if(!str) return 'Student';
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        });
    }
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        // Get values
        const fullname = document.getElementById('fullname').value.trim();
        const email = document.getElementById('email').value.trim();
        const whatsapp = document.getElementById('whatsapp').value.trim();
        
        if(!fullname || !email || !whatsapp) {
            alert('Please fill all fields: Name, Gmail and WhatsApp number.');
            return;
        }
        // Simple email check
        if(!email.includes('@') || !email.includes('.')) {
            alert('Please enter a valid Gmail or email address.');
            return;
        }
        // Nigerian number basic validation (optional)
        if(whatsapp.replace(/\D/g, '').length < 8) {
            alert('Please enter a valid WhatsApp number (e.g., 08012345678)');
            return;
        }
        
        // Here you can also send data to server via fetch, but redirect is priority.
        // For demo, store a small flag in session to simulate. Then show thank you page with new URL.
        // Also you could log data for debug (console)
        console.log(`New lead: ${fullname}, ${email}, ${whatsapp}`);
        
        // Directly show thank you page and URL change.
        showThankYouPage(fullname);
        
        // Optional: you can send data to a backend endpoint (if required, but core requirement redirect to thank you page)
        // I'll also show that the data is captured.
        // Uncomment if needed: send async
        /*
        fetch('/submit-lead', {
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({name:fullname, email, whatsapp})
        }).catch(err=>console.log(err));
        */
    });
    
    // If URL already contains ?thankyou=true on page load (for refresh case) we can re-show thank you but not necessary. 
    // just to be safe after redirecting manually maybe.
    if(window.location.search.includes('thankyou=true')) {
        // if someone lands on thank you manually without submission show generic version
        if(!document.getElementById('dynamicThankYou')) {
            // but ensure it's fine: do minimal.
            const heroAll = document.querySelector('.hero');
            if(heroAll) heroAll.style.display = 'none';
            const containerDiv = document.querySelector('.container');
            if(containerDiv) containerDiv.style.display = 'none';
            const thankDiv = document.createElement('div');
            thankDiv.id = 'dynamicThankYou';
            thankDiv.style.minHeight = '100vh';
            thankDiv.style.display = 'flex';
            thankDiv.style.alignItems = 'center';
            thankDiv.style.justifyContent = 'center';
            thankDiv.style.background = '#fefcf5';
            thankDiv.innerHTML = `<div style="background:white; padding:40px; border-radius:48px;"><i class="fas fa-heart"></i> <h2>Thank you for your interest!</h2><p>Please fill the form again to enroll.</p><a href="/" style="color:#cb7b3c;">Go back</a></div>`;
            document.body.appendChild(thankDiv);
        }
    }
</script>
</body>
</html>
